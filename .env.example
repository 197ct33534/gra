APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GARAGE_NAME="Gara Ô tô Đức Phát"
GARAGE_ADDRESS="Số 123 Đường Xe Hơi, Quận 7, TP. Hồ Chí Minh"
GARAGE_HOTLINE=0901234567
GARAGE_BANK_ID=MB
GARAGE_ACCOUNT_NO=0901234567
GARAGE_ACCOUNT_NAME="GARA O TO DUC PHAT"
GARAGE_WARRANTY="Bảo hành phụ tùng 06 tháng hoặc 10.000 km tùy điều kiện nào đến trước."

# Gara: nhắc bảo dưỡng & đối soát chuyển khoản
GARAGE_MESSAGING_DRIVER=log
GARAGE_MESSAGING_CHANNEL=zalo
SEPAY_WEBHOOK_API_KEY=
GARAGE_SERVICE_INTERVAL_KM=5000
GARAGE_SERVICE_INTERVAL_MONTHS=3

# Mua hàng: weighted_average | last_purchase
GARAGE_COST_METHOD=weighted_average
GARAGE_PURCHASE_VAT_RATE=8

# Backup (php artisan garage:backup)
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14

# Lịch hẹn
GARAGE_APPOINTMENT_MINUTES=60
GARAGE_BAY_BUFFER_MINUTES=15
GARAGE_APPOINTMENT_REMIND_HOURS=24

# Sổ quỹ: bắt buộc mở ca trước khi thu tiền mặt
GARAGE_CASH_REQUIRE_SESSION=true

# Bảo hành mặc định
GARAGE_WARRANTY_MONTHS=6
GARAGE_WARRANTY_KM=10000

# HĐĐT: log | viettel | fpt | misa | easyinvoice
GARAGE_EINVOICE_DRIVER=log
GARAGE_EINVOICE_SERIES=C26T
GARAGE_EINVOICE_TEMPLATE=1
GARAGE_EINVOICE_REQUIRE_PAID=true

# Messaging retry + Zalo (khi GARAGE_MESSAGING_DRIVER=zalo_zns)
GARAGE_MESSAGING_MAX_ATTEMPTS=3
ZALO_OA_ID=
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=

APP_NAME="Gara STG"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://stg.example.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gra
DB_USERNAME=gra
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@stg.example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

GARAGE_NAME="Gara Ô tô Đức Phát (STG)"
GARAGE_ADDRESS="Số 123 Đường Xe Hơi, Quận 7, TP. Hồ Chí Minh"
GARAGE_HOTLINE=0901234567
GARAGE_BANK_ID=MB
GARAGE_ACCOUNT_NO=0901234567
GARAGE_ACCOUNT_NAME="GARA O TO DUC PHAT"
GARAGE_WARRANTY="Bảo hành phụ tùng 06 tháng hoặc 10.000 km tùy điều kiện nào đến trước."
GARAGE_MESSAGING_DRIVER=log
GARAGE_MESSAGING_CHANNEL=zalo
SEPAY_WEBHOOK_API_KEY=
GARAGE_SERVICE_INTERVAL_KM=5000
GARAGE_SERVICE_INTERVAL_MONTHS=3
GARAGE_COST_METHOD=weighted_average
GARAGE_PURCHASE_VAT_RATE=8
GARAGE_TIMEZONE=Asia/Ho_Chi_Minh

# Backup (dùng với artisan garage:backup)
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14
